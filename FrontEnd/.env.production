# Production Environment Configuration
# This file is used when building for production: npm run build

# API Base URL - Full URL to your production backend
#
# IMPORTANT: Keep this EMPTY in production.
# Empty value = frontend uses relative URLs (e.g. /api/auth/login) which Nginx
# proxies to backend:8080 via the `location /api/` block in
# docker/FrontEnd/sampling-inspection.conf. Everything stays same-origin
# (port 8022 only) which is required for Safari iOS to persist session cookies.
#
# Setting this to http://host:8021 causes the SPA to call a different origin
# than the page is loaded from. iPad Safari's ITP then treats those XHR calls
# as cross-site and drops/blocks the session cookie, producing the login loop
# documented in br/FIX_IPAD_LOGIN_LOOP.md.
VITE_API_BASE_URL=

# Examples for different production scenarios:
# Same domain (recommended, current setting): VITE_API_BASE_URL=
# Different port (causes iPad login loop):    VITE_API_BASE_URL=http://your-server-ip:8021
# Different domain (requires HTTPS):          VITE_API_BASE_URL=https://api.yourcompany.com
# With subdomain (requires HTTPS):            VITE_API_BASE_URL=https://qc.yourcompany.com

# API Prefix
VITE_API_PREFIX=/api

# API Request Timeout (milliseconds) - Increase for slower networks
VITE_API_TIMEOUT=60000

# Backend Server Port (for reference)
VITE_BACKEND_PORT=8021