# Podman Compose Environment Variables
# Copy this file to .env and modify as needed
#
# Usage:
#   cp .env.example .env
#   podman-compose up -d --build
#
# Last Updated: 2026-01-28

# ==================== BUILD CONFIGURATION ====================
BUILD_DATE=2026-01-28
BUILD_VERSION=1.0.0

# ==================== DATABASE CONFIGURATION ====================
# Podman: Use 'host.containers.internal' to access host PostgreSQL
# Named container: Use container name like 'tiger_postgres_db'
DB_HOST=host.containers.internal

# ==================== PORT CONFIGURATION ====================
# Frontend port (maps to container port 80)
FRONTEND_PORT=8022

# Backend port (maps to container port 8080)
BACKEND_PORT=8021

# ==================== TIMEZONE ====================
# Used by MSSQL Sync Scheduler (node-cron)
TZ=Asia/Bangkok
