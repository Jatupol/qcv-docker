                         "cors":  "^2.8.5",
                         "dotenv":  "^17.2.2",
                         "drizzle-orm":  "^0.45.1",
                         "express":  "^4.18.2",
                         "express-session":  "^1.17.3",
                         "mssql":  "^12.0.0",
                         "multer":  "^2.0.2",
                         "node-cron":  "^4.2.1",
                         "nodemailer":  "^7.0.10",
                         "pg":  "^8.11.3",
                         "sharp":  "^0.34.5"
                     },
    "devDependencies":  {
                            "@types/bcrypt":  "^5.0.2",
                            "@types/connect-pg-simple":  "^7.0.3",
