{
    "name":  "sampling-inspection-qc-backend",
    "version":  "1.0.0",
    "description":  "Sampling Inspection Control SystemBackend",
    "main":  "dist/server.js",
    "scripts":  {
                    "dev":  "ts-node-dev --respawn --transpile-only src/server.ts",
                    "build":  "tsc",
                    "start":  "node dist/server.js",
                    "start:dev":  "npm run dev",
                    "clean":  "rimraf dist",
                    "build:clean":  "npm run clean \u0026\u0026 npm run build",
                    "type-check":  "tsc --noEmit",
                    "lint":  "echo \u0027Linting skipped for simplified setup\u0027",
                    "test":  "echo \u0027Tests skipped for simplified setup\u0027",
                    "db:generate":  "drizzle-kit generate",
                    "db:migrate":  "drizzle-kit migrate",
                    "db:push":  "drizzle-kit push",
                    "db:studio":  "drizzle-kit studio",
                    "db:check":  "ts-node scripts/check-schema.ts",
                    "db:check:auto":  "ts-node scripts/check-schema-auto.ts"
                },
    "keywords":  [
                     "manufacturing",
                     "quality-control",
                     "nodejs",
                     "typescript",
                     "postgresql",
                     "express"
                 ],
